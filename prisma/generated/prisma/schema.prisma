model Order {
  id String @id @default(cuid())

  orderId String      @unique @map("order_id")
  status  OrderStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  recipeIngredient   RecipeIngredient @relation(fields: [recipeIngredientId], references: [id])
  recipeIngredientId String           @map("recipe_ingredient_id")

  quantity Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("order_items")
}

model Courier {
  id String @id @default(cuid())

  name        String
  phoneNumber String @map("phone_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("couriers")
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Comment {
  id String @id @default(cuid())

  content String

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @map("recipe_id")

  autor    User   @relation(fields: [authorId], references: [id])
  authorId String @map("author_id")

  @@map("comments")
}

model Like {
  id String @id @default(cuid())

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @map("recipe_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([recipeId, userId])
  @@map("likes")
}

model Recipe {
  id String @id @default(cuid())

  title       String
  description String?
  calories    Int?
  cookingTime Int?       @map("cooking_time")
  difficulty  Difficulty

  autor    User   @relation(fields: [authorId], references: [id])
  authorId String @map("author_id")

  recipeIngredients RecipeIngredient[]
  recipeSteps       RecipeStep[]
  comments          Comment[]
  likes             Like[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recipes")
}

model Ingredient {
  id String @id @default(cuid())

  name        String
  defaultUnit Unit   @map("default_unit")

  recipes RecipeIngredient[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ingredients")
}

model RecipeIngredient {
  id String @id @default(cuid())

  name     String
  iconUrl  String @map("icon_url")
  content  String
  quantity Float
  unit     Unit
  price    String

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @map("recipe_id")

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String     @map("ingredient_id")

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id String @id @default(cuid())

  order       Int
  title       String
  description String

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String @map("recipe_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("recipe_steps")
}

enum Unit {
  GRAM
  MILLILITER
  PIECE
  TEASPOON
  TABLESPOON
  CLOVES
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  mooduleFormat = "cjs"
}

generator nestgraphql {
  moduleFormat       = "cjs"
  provider           = "node node_modules/prisma-nestjs-graphql"
  output             = "../generated/graphql"
  prismaClientImport = "@prisma/client"

  reExport                              = Directories
  omitModelsCount                       = true
  noAtomicOperations                    = true
  requireSingleFieldsInWhereUniqueInput = true
  combineScalarFilters                  = true
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  email    String @unique
  password String
  role     Role   @default(USER)

  profile      Profile?
  measurements BodyMeasurement?

  recipes  Recipe[]
  comments Comment[]
  likes    Like[]
  orders   Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Profile {
  id String @id @default(cuid())

  fullName String  @map("full_name")
  age      Int?
  gender   Gender?
  bio      String?

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model BodyMeasurement {
  id String @id @default(cuid())

  heightCm     Int? @map("height_cm")
  weightKg     Int? @map("weight_kg")
  goalWeightKg Int? @map("goal_weight_kg")

  chestCm Int? @map("chest_cm")
  waistCm Int? @map("waist_cm")
  thighCm Int? @map("thigh_cm")
  armCm   Int? @map("arm_cm")

  activityLevel ActivityLevel @map("activity_level")
  nutritionGoal NutritionGoal @map("nutrition_goal")

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("body_measurements")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SECONDARILY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum NutritionGoal {
  WEIGHT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
}
