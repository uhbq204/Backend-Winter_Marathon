    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/iconv-lite": "^0.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
